    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duongvm57/pi-paseo-orchestration.git"
  },
  "homepage": "https://github.com/duongvm57/pi-paseo-orchestration#readme",
  "bugs": {
    "url": "https://github.com/duongvm57/pi-paseo-orchestration/issues"
  },
  "files": [
